import "./style.css";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";

export type FormTab = "build" | "preview" | "responses";

export interface FormNavInfo {
  id: string;
  title: string;
  slug: string;
  published: boolean;
  themeColor: string;
}

<FormNav (form: FormNavInfo, active: FormTab, responseCount: number = -1)>
  <nav class="form-nav stack" aria-label="Form">
    <div class="form-nav-top row">
      <div class="stack is-xs">
        <a class="form-nav-back" href="/forms">← All forms</a>
        <div class="form-nav-heading row is-sm">
          <span class="form-nav-swatch" style={{ "--swatch": form.themeColor }} aria-hidden="true"></span>
          <h1 class="form-nav-title">{form.title}</h1>
          <Badge e:if={form.published} variant="success" dot>Live</Badge>
          <Badge e:else variant="secondary">Draft</Badge>
        </div>
      </div>

      <Button e:if={form.published} size="sm" href={`/f/${form.slug}`} attrs={{ target: "_blank", rel: "noopener" }}>Open public form ↗</Button>
    </div>

    <Tabs value={active}>
      <TabsList label="Form sections">
        <TabsTrigger value="build" href={`/forms/${form.id}`}>Build</TabsTrigger>
        <TabsTrigger value="preview" href={`/forms/${form.id}/preview`}>Preview</TabsTrigger>
        <TabsTrigger value="responses" href={`/forms/${form.id}/responses`}>
          Responses<Badge e:if={responseCount >= 0} variant="secondary" class="form-nav-count">{responseCount}</Badge>
        </TabsTrigger>
      </TabsList>
    </Tabs>
  </nav>
</FormNav>
