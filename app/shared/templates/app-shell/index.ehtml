import "./style.css";
import { redirect, session } from "@elements/app";
import { Avatar } from "@elements/ui/avatar";
import { Button } from "@elements/ui/button";
import { signout } from "#app/shared/services/auth";
import { Brand } from "#app/shared/templates/brand";

function onSignout() {
  signout();
  redirect("/signin");
}

<AppShell>
  <div class="app">
    <header class="shell-header">
      <div class="shell-header-inner row">
        <Brand href="/forms"/>

        <div class="row is-sm shell-user">
          <Avatar alt={session.get("userName") ?? ""} size="sm" attrs={{ "aria-hidden": "true" }}/>
          <span class="shell-name">{session.get("userName")}</span>
          <Button variant="ghost" size="sm" onclick={() => onSignout()}>Sign out</Button>
        </div>
      </div>
    </header>

    <main class="app-main shell-main">
      <slot/>
    </main>
  </div>
</AppShell>
