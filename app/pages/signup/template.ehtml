import "./style.css";
import { redirect } from "@elements/app";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { AuthAside } from "#app/shared/templates/auth-aside";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/forms");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Create an account · fieldloft</title>
    <meta name="description" content="Create a fieldloft account">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="auth">
      <AuthAside/>

      <main class="auth-main">
        <div class="auth-panel">
          <form class="stack is-md" onsubmit={() => onSubmit(form)}>
            <h2>Create an account</h2>

            <Alert e:if={form.error} variant="danger" description={form.error}>
              <Icon name="alert-circle"/>
            </Alert>

            <Field label="Name" reserveError={false}>
              <Input name="name" value={form.name} required attrs={{ autocomplete: "name" }}/>
            </Field>

            <Field label="Email" reserveError={false}>
              <Input type="email"
                     name="email"
                     value={form.email}
                     placeholder="you@example.com"
                     required
                     attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }}/>
            </Field>

            <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`}>
              <Input type="password"
                     name="password"
                     value={form.password}
                     required
                     attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }}/>
            </Field>

            <Button type="submit" variant="primary" block loading={form.busy}>Create account</Button>

            <p class="hint">Have an account? <a href="/signin">Sign in</a></p>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
