import "./style.css";
import { redirect } from "@elements/app";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { AuthAside } from "#app/shared/templates/auth-aside";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SignupForm) {
  form.busy = true;

  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect("/forms");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

<html lang="en" class="page-signup" (
  private form: SignupForm = { name: "", email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Create an account · fieldloft</title>
    <meta name="description" content="Create a fieldloft account">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="auth">
      <AuthAside/>

      <main class="auth-main">
        <div class="auth-panel">
          <form class="stack is-md" onsubmit={() => onSubmit(form)}>
            <h2>Create an account</h2>

            <p e:if={form.error} class="error" role="alert">{form.error}</p>

            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" value={form.name} autocomplete="name" required>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input id="email"
                     name="email"
                     type="email"
                     value={form.email}
                     autocomplete="email"
                     autocapitalize="none"
                     spellcheck={false}
                     placeholder="you@example.com"
                     required>
            </div>

            <div class="field">
              <label for="password">Password</label>
              <input id="password"
                     name="password"
                     type="password"
                     value={form.password}
                     autocomplete="new-password"
                     minlength={MIN_PASSWORD}
                     required>
              <p class="hint">At least {MIN_PASSWORD} characters.</p>
            </div>

            <button type="submit" class="is-primary is-block" disabled={form.busy}>Create account</button>

            <p class="hint">Have an account? <a href="/signin">Sign in</a></p>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
