import "./style.css";
import { redirect } from "@elements/app";
import { signin, DEMO_ACCOUNTS, DEMO_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { AuthAside } from "#app/shared/templates/auth-aside";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/forms");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onPickDemo(form: SigninForm, email: string) {
  form.email = email;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · fieldloft</title>
    <meta name="description" content="Sign in to fieldloft">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="auth">
      <AuthAside/>

      <main class="auth-main">
        <div class="auth-panel stack is-xl">
          <form class="stack is-md" onsubmit={() => onSubmit(form)}>
            <h2>Sign in</h2>

            <Alert e:if={form.error} variant="danger" description={form.error}>
              <Icon name="alert-circle"/>
            </Alert>

            <Field label="Email" reserveError={false}>
              <Input type="email"
                     name="email"
                     value={form.email}
                     placeholder="you@example.com"
                     required
                     attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }}/>
            </Field>

            <Field label="Password" reserveError={false}>
              <Input type="password"
                     name="password"
                     value={form.password}
                     required
                     attrs={{ autocomplete: "current-password" }}/>
            </Field>

            <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>

            <p class="hint">New here? <a href="/signup">Create an account</a></p>
          </form>

          <section class="auth-demo stack is-sm" aria-labelledby="demo-title">
            <p id="demo-title" class="auth-demo-title">Demo accounts</p>

            <button e:for={account of DEMO_ACCOUNTS}
                    e:key={(a) => a.email}
                    type="button"
                    class="auth-demo-account row"
                    onclick={() => onPickDemo(form, account.email)}>
              <span>
                <strong>{account.name}</strong>
                <small>{account.email}</small>
                <small>{account.forms}</small>
              </span>
              <span aria-hidden="true">→</span>
            </button>

            <p class="auth-demo-password">Password for both: <code>{DEMO_PASSWORD}</code></p>
          </section>
        </div>
      </main>
    </div>
  </body>
</html>
